chat_sessions: defineTable({
    userId: v.id("users"),
    title: v.string(),
  }).index("by_userId", ["userId"]),

  chat_messages: defineTable({
    sessionId: v.id("chat_sessions"),
    text: v.string(),
    sender: v.union(v.literal("user"), v.literal("assistant")),
    timestamp: v.number(),
  }).index("by_sessionId", ["sessionId"]),
